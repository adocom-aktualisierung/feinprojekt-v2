# LiteSpeed-kompatibel via mod_rewrite (LimitExcept wird von LiteSpeed
# in .htaccess nicht methodenspezifisch ausgewertet und sperrte alles).

RewriteEngine On

# Config-Dateien nie ausliefern (alle Methoden)
RewriteRule ^config\. - [F,L]

# PHP-Endpunkte nur per POST + OPTIONS (CORS-Preflight)
RewriteCond %{REQUEST_METHOD} !^(POST|OPTIONS)$
RewriteRule \.php$ - [F,L]
